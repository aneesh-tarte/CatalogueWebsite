// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  library      UserLibrary[]
}

enum MediaType {
  GAME
  ANIME
  MANGA
}

model MediaItem {
  id            String        @id @default(uuid())
  externalId    String
  type          MediaType
  title         String
  synopsis      String?
  coverImageUrl String?
  releaseDate   DateTime?
  trackedBy     UserLibrary[]

  @@index([externalId])
  @@index([type])
}

enum TrackStatus {
  PLAN_TO_TRACK
  IN_PROGRESS
  COMPLETED
  DROPPED
}

model UserLibrary {
  id              String      @id @default(uuid())
  userId          String
  mediaItemId     String
  status          TrackStatus
  currentProgress Int         @default(0)
  personalScore   Int?
  reviewText      String?
  updatedAt       DateTime    @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaItem MediaItem @relation(fields: [mediaItemId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaItemId])
}

model NewsArticle {
  id          String   @id @default(uuid())
  headline    String
  sourceUrl   String
  imageUrl    String?
  publisher   String
  publishedAt DateTime
}
